  {
   "fieldname": "requested_by",
   "fieldtype": "Link",
   "options": "User",
   "label": "Requested By",
   "description": "Usually the employee's own user account. HR can file on the employee's behalf if requested in writing."
  },
  {
   "fieldname": "column_break_id",
   "fieldtype": "Column Break"
  },
  {
   "default": "Specific Data Categories",
