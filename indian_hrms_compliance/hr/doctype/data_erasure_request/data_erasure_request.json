   "fieldname": "header_html",
   "fieldtype": "HTML",
   "options": "<div style='background:#fdecea;border-left:4px solid #d33;padding:10px 14px;margin-bottom:8px'><strong>Right-to-Erasure (DPDP Sec 12)</strong> &mdash; Mandatory legal review before execution &mdash; some data has statutory retention obligations (PF/ESI 7 yrs, IT Act 8 yrs) and CANNOT be erased while the obligation stands. Execution is logged in Data Access Log + erasure_log.</div>"
  },
  {
   "fieldname": "identity_section",
   "fieldtype": "Section Break",
   "label": "Request"
  },
  {
   "fieldname": "employee",
