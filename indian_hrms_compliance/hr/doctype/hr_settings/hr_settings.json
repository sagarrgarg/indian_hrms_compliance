   "label": "Probation & Confirmation"
  },
  {
   "fieldname": "probation_defaults_section",
   "fieldtype": "Section Break",
   "label": "Probation Defaults",
   "description": "Defaults applied when an Employee is created on Probation, and the lookahead window for daily Probation Review reminder ToDos."
  },
  {
   "default": "180",
   "fieldname": "default_probation_period_days",
   "fieldtype": "Int",
   "label": "Default Probation Period (days)",
   "non_negative": 1,
   "description": "When a new Employee is created with confirmation_status='Probation' and no Scheduled Confirmation Date, it is auto-set to date_of_joining + this many days. Typical: 180 (6 months)."
  },
  {
   "default": "30",
   "fieldname": "probation_review_reminder_window_days",
   "fieldtype": "Int",
   "label": "Probation Review Reminder Window (days)",
   "non_negative": 1,
   "description": "Daily scheduler creates Probation Review reminder ToDos for Employees whose Scheduled Confirmation Date falls within this many days from today. Default 30."
  }
