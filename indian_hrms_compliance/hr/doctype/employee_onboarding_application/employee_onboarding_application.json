   "description": "As on Aadhaar / statutory records. Mandatory on a candidate submission."
  },
  {
   "fieldname": "col_personal",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "pan_number",
   "fieldtype": "Data",
   "label": "PAN",
   "description": "Format ABCDE1234F (5 letters + 4 digits + 1 letter)."
  },
  {
   "fieldname": "aadhaar_number",
   "fieldtype": "Data",
   "label": "Aadhaar Number",
   "length": 12,
   "print_hide": 1,
   "no_copy": 1,
   "description": "Full 12-digit Aadhaar number. Verified against the UIDAI checksum. Stored only for statutory PF/ESI seeding under the DPDP Act 2023 consent above."
  },
  {
   "fieldname": "aadhaar_last_4",
   "fieldtype": "Data",
   "label": "Aadhaar (last 4)",
   "length": 4,
   "read_only": 1,
   "description": "Auto-derived from the Aadhaar number above — kept for audit and report compatibility."
  },
  {
   "fieldname": "uan_number",
   "fieldtype": "Data",
   "label": "UAN (if any)",
   "description": "12-digit Universal Account Number from your previous employer's PF."
  },
  {
   "fieldname": "esic_ip_number",
   "fieldtype": "Data",
   "label": "ESIC Insurance (IP) No. (if any)",
   "description": "10-digit ESIC number from an earlier employer. It stays the same for life."
  },
  {
   "fieldname": "form_11_section",
   "fieldtype": "Section Break",
   "label": "PF Declaration (Form 11)",
   "description": "Previous PF / pension membership. Skipped entirely when the candidate was never a PF member."
  },
  {
   "fieldname": "has_previous_pf",
   "fieldtype": "Select",
   "label": "Earlier a PF Member?",
   "options": "\nNo\nYes",
   "description": "Form 11 item 7 - earlier a member of the EPF Scheme, 1952."
  },
  {
   "fieldname": "earlier_eps_member",
   "fieldtype": "Select",
   "label": "Earlier a Pension (EPS) Member?",
   "options": "\nYes\nNo",
   "depends_on": "eval:doc.has_previous_pf=='Yes'",
   "description": "Form 11 item 8 - earlier a member of the Employees' Pension Scheme, 1995."
  },
  {
   "fieldname": "previous_pf_account_number",
   "fieldtype": "Data",
   "label": "Previous PF Account Number",
   "depends_on": "eval:doc.has_previous_pf=='Yes'",
   "description": "e.g. DL/CPM/0012345/000/0001234"
  },
  {
   "fieldname": "col_form_11",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "previous_employment_doj",
