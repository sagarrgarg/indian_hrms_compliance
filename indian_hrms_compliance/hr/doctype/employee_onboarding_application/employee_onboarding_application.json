   "options": "Employee Onboarding Document",
   "description": "Mandatory-document enforcement happens in the controller (_validate_required_documents) so HR invite Drafts can exist without uploads."
  },
  {
   "fieldname": "consent_section",
   "fieldtype": "Section Break",
   "label": "Consent (DPDP Act, 2023)"
  },
  {
   "fieldname": "dpdp_consent",
   "fieldtype": "Check",
   "label": "I consent to this organisation collecting and processing the details above for employee onboarding, in line with the DPDP Act, 2023.",
   "default": "0"
  },
  {
   "fieldname": "consent_text_version",
   "fieldtype": "Data",
   "label": "Consent Text Version",
   "read_only": 1,
   "default": "1.0",
