  {
   "fieldname": "consent_ip",
   "fieldtype": "Data",
   "label": "Consent Source IP",
   "read_only": 1,
   "no_copy": 1,
   "description": "Source IP of the submitting browser. Audit-only — used for DPDP grievance investigations."
  },
  {
   "fieldname": "consent_user_agent",
   "fieldtype": "Small Text",
   "label": "Consent User Agent",
   "read_only": 1,
   "no_copy": 1,
   "description": "Browser/device signature captured at submission. Together with IP + timestamp + consent version this forms the DPDP evidence trail. (MAC addresses are not technically obtainable by websites.)"
