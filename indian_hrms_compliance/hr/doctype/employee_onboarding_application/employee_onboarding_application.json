  {
   "fieldname": "is_fresher",
   "fieldtype": "Check",
   "label": "Fresher (derived)",
   "default": "0",
   "hidden": 1,
   "read_only": 1,
   "description": "Internal flag derived from Employment Background: 1 when 'Fresher' was selected. Informational; the Previous Payslip requirement is gated on Employment Background being blank, not on this flag."
  },
  {
   "fieldname": "documents",
   "fieldtype": "Table",
